	$CMD "$BOX" grep -Fx 'ExecStart=/usr/bin/krb5_prestash fetch' \
	    "$UNIT" >/dev/null
	$CMD "$BOX" /usr/bin/krb5_prestash fetch
	verify_prestashed_material "$BOX" "$USER"
}

