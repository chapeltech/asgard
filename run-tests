	    grep -Fx \
	        "ExecStart=/usr/libexec/prefork /usr/sbin/krb5_hostd -P" \
	        "$unitdir/krb5-hostd.service" >/dev/null
	    grep -Fx \
	        "ExecStart=/usr/libexec/prefork /usr/bin/knc -iS /run/krb5_hostd" \
	        "$unitdir/krb5-hostd-knc.service" >/dev/null
	    grep -Fx "ExecStart=/usr/bin/krb5_prestash fetch" \
	        "$unitdir/krb5-prestash-refresh.service" >/dev/null
	    grep -Fx "Persistent=yes" \
	        "$unitdir/krb5-prestash-refresh.timer" >/dev/null
	    systemd-analyze verify --man=no \
	        "$unitdir"/krb5-hostd*.socket \
	        "$unitdir"/krb5-hostd*.service \
	        "$unitdir"/krb5-hostd.target \
	        "$unitdir"/krb5-prestash-refresh.service \
	        "$unitdir"/krb5-prestash-refresh.timer
	    systemd-analyze calendar "*-*-* 02:00:00" >/dev/null
	    if command -v rpm >/dev/null 2>&1; then
	        rpm -qf "$unitdir/krb5-hostd.service" |
	            grep -F krb5-hostd >/dev/null
	    else
	        dpkg-query -S "$unitdir/krb5-hostd.service" |
	            grep -F krb5-hostd >/dev/null
	    fi'
}

