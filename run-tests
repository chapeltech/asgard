		    realm=EXAMPLE.COM nameserver+=kdc1.example.com
	fi
	$CMD kdc1 bifrost -l modify_domain example.com \
	    mta+=mail.example.com:10 \
	    dmarc_policy=reject \
	    dmarc_rua=mailto:dmarc@example.com

	wait_for_dns
}

test_asgard_dns() {
	[ "$DNS" = 1 ] || return 0

	echo "Testing bifrost-managed DNS"

	$CMD bastion dig @172.30.0.11 +short kdc1.example.com A | \
	    grep '^172\.30\.0\.11$' >/dev/null
	$CMD bastion dig @172.30.0.11 +short httpserver.example.com A | \
	    grep '^172\.30\.0\.21$' >/dev/null
	$CMD bastion dig @172.30.0.11 +short mail.example.com A | \
	    grep '^172\.30\.0\.27$' >/dev/null
	$CMD bastion dig @172.30.0.11 +short _kerberos._udp.example.com SRV | \
	    grep 'kdc1.example.com.' >/dev/null
	$CMD bastion dig @172.30.0.11 +short example.com MX | \
	    grep '10 mail.example.com.' >/dev/null
	$CMD bastion dig @172.30.0.11 +short example.com TXT | \
	    grep '"v=spf1 mx -all"' >/dev/null
	$CMD bastion dig @172.30.0.11 +short _dmarc.example.com TXT | \
	    grep '"v=DMARC1; p=reject; rua=mailto:dmarc@example.com"' \
	    >/dev/null
	$CMD bastion dig @172.30.0.11 +short example.com DNSKEY | \
	    grep '^257 3 13 ' >/dev/null
	$CMD bastion dig @172.30.0.11 +dnssec example.com DNSKEY | \
	    grep '[[:space:]]RRSIG[[:space:]]DNSKEY[[:space:]]' >/dev/null
	$CMD bastion dig @172.30.0.11 +dnssec missing.example.com A | \
	    grep '[[:space:]]NSEC[[:space:]]' >/dev/null

	if [ "$DNSSEC" = 1 ]; then
		$CMD kdc1 bifrost -l query_domain example.com | \
		    grep '^dnssec_ksk_ds_sha256:' >/dev/null
		$CMD kdc1 bifrost -l modify_domain example.com \
		    ksk+=ECDSAP256SHA256:RANDOM
		COUNT=$($CMD kdc1 bifrost -l query_domain example.com | \
		    grep -c '^dnssec_ksk_dnskey:')
		[ "$COUNT" -ge 2 ]
		COUNT=$($CMD bastion dig @172.30.0.11 +short example.com DNSKEY | \
		    grep -c '^257 3 13 ')
		[ "$COUNT" -ge 2 ]
		$CMD kdc1 bifrost -l list_actions \
		    action_type=check_dnssec_ksk_rollover \
		    target_name=example.com | \
		    grep 'parent DS.*not visible' >/dev/null
	fi
	$CMD kdc1 bifrost -l list_actions \
	    action_type=publish_dns_domain target_name=example.com | \
	    grep 'publish_dns_domain.*dns_domain.*example.com.*done' \
	    >/dev/null

	$CMD bastion /bin/sh -c 'cat >/tmp/krb5-dns.conf' <<'EOM'
[libdefaults]
	default_realm = EXAMPLE.COM
	rdns = false
	dns_lookup_kdc = true
	pkinit_anchors = FILE:/etc/krb5/ca-pub.pem
EOM
	$CMD bastion env KRB5_CONFIG=/tmp/krb5-dns.conf \
	    KRB5CCNAME=FILE:/tmp/dns-discovery.ccache \
	    kinit admin < $passwd
	$CMD bastion env KRB5_CONFIG=/tmp/krb5-dns.conf \
	    KRB5CCNAME=FILE:/tmp/dns-discovery.ccache \
	    klist >/dev/null
}

