	$CMD "$BOX" test -f /var/spool/tickets/www-data
	$CMD "$BOX" su -s /bin/sh -c \
	    'PATH=/usr/lib/asgard/bin:/usr/bin:/bin \
	    klist -c FILE:/var/spool/tickets/www-data >/dev/null' www-data

	$CMD "$BOX" test -f /var/spool/certs/www-data
	$CMD "$BOX" su -s /bin/sh -c \
	    'PATH=/usr/lib/asgard/bin:/usr/bin:/bin \
	    kinit -C PEM-FILE:/var/spool/certs/www-data \
	    www-data@EXAMPLE.COM && \
	    PATH=/usr/lib/asgard/bin:/usr/bin:/bin klist >/dev/null' www-data
