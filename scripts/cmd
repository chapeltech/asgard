#!/bin/sh -e

SETUP_FILE=/var/heimdal/setup.done
ASGARD_REALMS=/var/heimdal/realms

usage() {

	( echo "$@"
	  echo
	  echo "usage:"
	  echo "  docker run create-admin <USER>"
	  echo "  docker run print-ca"
	  echo "  docker run print-krb5-conf"
	  echo "  docker run setup-master <REALM> [REALM...]"
	  echo "  docker run setup-slave <REALM>"
	  echo "  docker run shell"
	  echo "  docker run start-kdc"
	  echo "  docker run start-client"
	) 1>&2
	exit 1
}

emit_cmd() {

	echo "---- $@"
	"$@"
}

emit_file() {

	echo "---- $1"
	cat "$1"
}

emit_config() {

	echo ------------------------------------------------------------
	emit_cmd set
	emit_cmd ls -l /etc
	emit_file /etc/krb5.conf
	emit_cmd ls -l /etc/krb5
	emit_cmd ls -l /var/heimdal
	emit_cmd krb5_admin -l list \*
	echo ------------------------------------------------------------
}

prepare() {

	[ $debug -gt 0 ]	&& emit_config

	#
	# XXXrcd: for now, wait until we are setup---this is a hack,
	#         later this will be done in a better way as we'll
	#         have to listen for setup...

	while [ ! -f "$SETUP_FILE" ]; do
		sleep 1;
	done

	ln -sf ../../var/heimdal/ca-pub.pem /etc/krb5/ca-pub.pem
}

realm_dn() {
	realm="$1"
	dn=

	while [ -n "$realm" ]; do
		label="${realm%%.*}"
		case "$label" in
		''|*[!A-Za-z0-9-]*)
			usage "realm is not a dotted DNS name: $1"
			;;
		esac
		dn="${dn}${dn:+,}DC=$label"
		case "$realm" in
		*.*)	realm="${realm#*.}"	;;
		*)	realm=			;;
		esac
	done

	printf '%s\n' "$dn"
}

realm_conf_name() {

	printf '%s\n' "$1" | tr . _
}

mk_krb5_realm_conf() {
	TYPE="$1"
	R="$2"
	REALM="$(cat /var/heimdal/realm)"
	MASTER="$(cat /var/heimdal/master)"

	[ "$TYPE" = master ] && MASTER=127.0.0.1

	if [ "$R" = "$REALM" ]; then
		cat <<EOM
[libdefaults]
	default_realm			= $REALM
EOM
	fi

	cat <<EOM
[realms]
	$R = {
		kdc = $MASTER
		kpasswd_server = $MASTER
	}
EOM

	[ "$TYPE" = client ] && return

	cat <<EOM
[kdc]
EOM

	DN="$(realm_dn "$R")"
	cat <<EOM
	realms = {
		$R = {
			kx509 = {
				user = {
					include_pkinit_san = true
					subject_name = CN=\${principal-name-without-realm},$DN
					ekus = 1.3.6.1.5.5.7.3.2
					ca = FILE:/var/heimdal/kdc-priv.pem
				}
				hostbased_service = {
					HTTP = {
						include_dnsname_san = true
						subject_name = CN=\${principal-host-name},$DN
						ekus = 1.3.6.1.5.5.7.3.1
						ca = FILE:/var/heimdal/kdc-priv.pem
					}
				}
			}
		}
	}
EOM
}

write_krb5_conf() {
	DIR=/var/heimdal/krb5.conf.d
	REALM="$(cat /var/heimdal/realm)"
	REALMS="$REALM"
	[ -f "$ASGARD_REALMS" ] && REALMS="$(cat "$ASGARD_REALMS")"

	mkdir -p "$DIR"
	for R in $REALMS; do
		FILE="$DIR/$(realm_conf_name "$R").conf"
		mk_krb5_realm_conf "$1" "$R" > "$FILE.new"
		mv "$FILE.new" "$FILE"
	done
}

mk_krb5_client_conf() {
	REALM="$(cat /var/heimdal/realm)"
	REALMS="$REALM"
	[ -f "$ASGARD_REALMS" ] && REALMS="$(cat "$ASGARD_REALMS")"

	cat <<EOM
[libdefaults]
	rdns = false
	pkinit_anchors = FILE:/etc/krb5/ca-pub.pem
	ignore-acceptor-hostname = true
EOM
	for R in $REALMS; do
		mk_krb5_realm_conf "$1" "$R"
	done
}

create_bifrost_admins() {

	krb5_admin -l query_group bifrost-admins >/dev/null 2>&1 && return

	krb5_admin -l create_group bifrost-admins
	for VERB in bind_host create_user create_subject modify \
	    principal_map_add sacls_add; do
		krb5_admin -l sacls_add "$VERB" bifrost-admins
	done
}

create_admin() {

	[ $# -ne 1 ]	&& usage "create-user takes exactly one argument"
	[ -s /var/heimdal/realm ] || usage "KDC is not setup yet"

	REALM="$(cat /var/heimdal/realm)"
	PRINCIPAL="$1@$REALM"
	create_bifrost_admins
	krb5_admin -l create_user "$PRINCIPAL"
	krb5_admin -l create_subject "$PRINCIPAL" type=krb5
	krb5_admin -l modify_group bifrost-admins "member+=$PRINCIPAL"
}

print_ca() {

	[ $# -gt 0 ]	&& usage "print-ca takes zero arguments"

	[ -f "$SETUP_FILE" ] || usage "KDC is not setup yet"

	cat /var/heimdal/ca-pub.pem
}

print_krb5_conf() {

	[ $# -gt 0 ]	&& usage "print-krb5-conf takes zero arguments"

	[ -f "$SETUP_FILE" ] || usage "KDC is not setup yet"

	mk_krb5_client_conf client
}

install_kdc_keytabs() {

	for R in $(cat "$ASGARD_REALMS"); do
		krb5_keytab -Z "host@$R"
		krb5_keytab -Z "krb5_admin@$R"
		krb5_keytab -Z "HTTP@$R"
		krb5_keytab -Z "iprop@$R"
	done
}

start_kdc() {

	[ $# -gt 0 ]	&& usage "start_kdc takes zero arguments"

	prepare
	install_kdc_keytabs
	exec /usr/bin/tini -- /usr/bin/supervisord -c /etc/supervisord.conf
}

start_client() {

	[ $# -gt 0 ]	&& usage "start_client takes zero arguments"

	mkdir -p /run/bifrost /var/spool/tickets /var/spool/certs
	exec /usr/bin/tini -- /usr/bin/supervisord \
	    -c /etc/client-supervisord.conf
}

shell() {

	[ $# -gt 0 ]	&& usage "start_kdc takes zero arguments"

	prepare
	exec /bin/ksh -i
}

setup_master() {
	REALM="$1"

	[ $# -lt 1 ] && usage "setup-master needs at least one REALM"

	echo Setting up KDC for REALM=$REALM

	# XXXrcd: this is a short term solution, eventually we will
	#         done something via bifrost only

	# XXXrcd: validate REALM

	cd /var/heimdal

	[ -f "$SETUP_FILE" ] && usage "Realm is already setup, exiting..."

	echo "$REALM"	> /var/heimdal/realm
	for R in "$@"; do
		echo "$R" >> "$ASGARD_REALMS"
	done
	hostname	> /var/heimdal/master

	write_krb5_conf master

	krb5_admin -l init_db
	create_bifrost_admins
	for R in "$@"; do
		init_realm "$R"
	done

	REALM_DN="$(realm_dn "$REALM")"
	hxtool issue-certificate					\
			--self-signed					\
			--issue-ca					\
			--generate-key=rsa				\
			--subject="CN=CA,$REALM_DN"			\
			--lifetime=20years				\
			--certificate="FILE:ca-priv.pem"

	hxtool cc --no-private-keys ca-priv.pem ca-pub.pem

	hxtool issue-certificate					\
			--ca-certificate=FILE:ca-priv.pem		\
			--generate-key=rsa				\
			--issue-ca					\
			--path-length=0				\
			--type="pkinit-kdc"				\
			--ku=keyEncipherment				\
			--ku=digitalSignature				\
			--ku=keyCertSign				\
			--pk-init-principal="krbtgt/$REALM@$REALM"	\
			--subject="uid=kdc,$REALM_DN"			\
			--certificate="FILE:kdc-priv.pem"

	hxtool cc --no-private-keys kdc-priv.pem kdc-pub.pem

	krb5_admin -l master > /etc/krb5/master

	touch "$SETUP_FILE"
}

create_realm_principal() {
	PRINCIPAL="$1"
	MAX_LIFE="$2"
	MAX_RENEWABLE_LIFE="$3"
	shift 3

	krb5_admin -l create "$PRINCIPAL"
	krb5_admin -l modify "$PRINCIPAL" \
	    max_life="$MAX_LIFE" max_renewable_life="$MAX_RENEWABLE_LIFE" \
	    "$@"
}

init_realm() {
	R="$1"

	create_realm_principal "krbtgt/$R@$R" 1d 1w
	create_realm_principal "kadmin/changepw@$R" 5m 5m \
	    attributes-=allow_tgs_req \
	    attributes+=password_changing_service \
	    attributes-=allow_postdated \
	    attributes-=allow_renewable \
	    attributes-=allow_proxiable \
	    attributes+=requires_preauth
	create_realm_principal "WELLKNOWN/ANONYMOUS@$R" 1h 1h \
	    attributes+=requires_preauth
	create_realm_principal "WELLKNOWN/FEDERATED@$R" 1h 1h \
	    attributes+=requires_preauth
	if ! krb5_admin -l query \
	    'WELLKNOWN/org.h5l.fast-cookie@WELLKNOWN:ORG.H5L' >/dev/null 2>&1; then
		create_realm_principal \
		    'WELLKNOWN/org.h5l.fast-cookie@WELLKNOWN:ORG.H5L' 1h 1h \
		    attributes+=requires_preauth \
		    attributes-=allow_tgs_req \
		    attributes-=allow_tix
	fi
}

setup_slave() {
	REALM="$1"
	MASTER="$2"

	echo Setting up subservient KDC for REALM=$REALM

	[ -z "$REALM" ]  && usage "needs two args, REALM and MASTER"     
	[ -z "$MASTER" ] && usage "needs two args, REALM and MASTER"     

	echo "$REALM"	> /var/heimdal/realm
	echo "$MASTER"	> /var/heimdal/master

	write_krb5_conf slave

	krb5_keytab iprop

	touch "$SETUP_FILE"
}


debug=0
done=0

args=`getopt d $*`	|| usage

set -- $args
while [ $# -gt 0 ]; do
	case "$1" in
		-d)	debug=$(expr $debug + 1)	;;
		--)	done=1				;;
	esac
	shift
	[ "$done" = 1 ] && break
done

if [ $debug -gt 0 ]; then
	export KRB5_TRACE=0-$(expr $debug + 3)/SYSLOG
fi

if [ $# -eq 0 ]; then
	usage "We require at least one argument"
fi

CMD="$1"
shift

CMD=$(echo "$CMD" | sed s/_/-/g)

#
# XXXrcd:
#		add cmds: get_krb5_conf, get_ca...

case "$CMD" in
	create-admin)		create_admin "$@"		;;
	print-ca)		print_ca "$@"			;;
	print-krb5-conf)	print_krb5_conf "$@"		;;
	setup-master)		setup_master "$@"		;;
	setup-slave)		setup_slave "$@"		;;
	shell)			shell "$@"			;;
	start-kdc)		start_kdc "$@"			;;
	start-client)		start_client "$@"			;;
	*)			usage "unrecognised: $CMD"	;;
esac
