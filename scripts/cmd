#!/bin/sh -e

SETUP_FILE=/var/heimdal/setup.done
. /scripts/asgard-realms
ASGARD_IPROP_ACL=/run/asgard/iprop-acl

usage() {

	( echo "$@"
	  echo
	  echo "usage:"
	  echo "  docker run create-admin <USER>"
	  echo "  docker run print-ca"
	  echo "  docker run setup-master <REALM>"
	  echo "  docker run setup-slave <REALM> <MASTER>"
	  echo "  docker run activate-slave"
	  echo "  docker run approve-slave <REALM> <HOST> <BINDING>"
	  echo "  docker run status"
	  echo "  docker run bifrost <ARGS>"
	  echo "  docker run reconcile"
	  echo "  docker run shell"
	  echo "  docker run start-kdc"
	  echo "  docker run start-client"
	) 1>&2
	exit 1
}

emit_cmd() {

	echo "---- $@"
	"$@"
}

emit_file() {

	echo "---- $1"
	cat "$1"
}

emit_config() {

	echo ------------------------------------------------------------
	emit_cmd set
	emit_cmd ls -l /etc
	emit_file /etc/krb5.conf
	emit_cmd ls -l /etc/krb5
	emit_cmd ls -l /var/heimdal
	emit_cmd krb5_admin -l list \*
	echo ------------------------------------------------------------
}

configure_inetd() {

	BIFROSTD="$(bifrost -l query_config bifrostd)"
	cp /etc/inetd.conf /run/asgard/inetd.conf.old
	if [ "$BIFROSTD" = 1 ]; then
		sed -i 's/^#bifrost/bifrost/' /etc/inetd.conf
	else
		sed -i 's/^bifrost/#bifrost/' /etc/inetd.conf
	fi
	if ! cmp -s /etc/inetd.conf /run/asgard/inetd.conf.old; then
		touch /run/asgard/inetd.changed
	fi
}

reconcile() (
	mkdir -p /run/asgard
	exec 7>/run/asgard/reconcile.lock
	flock 7
	if [ "$(hostname)" = "$(cat /var/heimdal/master)" ]; then
		/scripts/asgard-install-certificates \
		    "$(/scripts/asgard-certificates "$(hostname)")"
	fi
	reconcile_realms
	configure_inetd
	[ -S /run/asgard/supervisor.sock ] || exit 0
	if [ -f /run/asgard/realms.changed ] ||
	    [ -f /run/asgard/certificates.changed ]; then
		supervisorctl -c /etc/supervisord.conf restart kdc kpasswdd
		rm -f /run/asgard/realms.changed /run/asgard/certificates.changed
	fi
	if [ -f /run/asgard/inetd.changed ]; then
		supervisorctl -c /etc/supervisord.conf restart inetd
		rm /run/asgard/inetd.changed
	fi
)

prepare() {

	[ $debug -gt 0 ]	&& emit_config

	#
	# XXXrcd: for now, wait until we are setup---this is a hack,
	#         later this will be done in a better way as we'll
	#         have to listen for setup...

	while [ ! -f "$SETUP_FILE" ]; do
		sleep 1;
	done
}

create_bifrost_admins() {

	if [ -z "$(bifrost -l query_group bifrost-admins)" ]; then
		krb5_admin -l create_group bifrost-admins owner=bifrost-admins
	fi
	for VERB in bind_host create_user create_subject modify \
	    principal_map_add sacls_add; do
		if ! krb5_admin -l sacls_query verb="$VERB" |
		    grep -Fx bifrost-admins >/dev/null; then
			krb5_admin -l sacls_add "$VERB" bifrost-admins
		fi
	done
}
create_admin() {

	[ $# -ne 1 ]	&& usage "create-user takes exactly one argument"
	[ -s /var/heimdal/realm ] || usage "KDC is not setup yet"

	REALM="$(cat /var/heimdal/realm)"
	PRINCIPAL="$1@$REALM"
	create_bifrost_admins
	krb5_admin -l create_user "$PRINCIPAL"
	krb5_admin -l create_subject "$PRINCIPAL" type=krb5
	krb5_admin -l modify_group bifrost-admins "member+=$PRINCIPAL"
}

print_ca() {

	[ $# -gt 0 ]	&& usage "print-ca takes zero arguments"

	[ -f "$SETUP_FILE" ] || usage "KDC is not setup yet"

	cat /var/heimdal/ca-pub.pem
}

start_kdc() {

	[ $# -gt 0 ]	&& usage "start_kdc takes zero arguments"

	prepare
	mkdir -p /run/asgard
	configure_inetd
	export BIFROST_IPROP_ACL="$ASGARD_IPROP_ACL"
	reconcile_realms
	if [ "$BIFROSTD" = 1 ] && [ ! -s /var/heimdal/bifrost-priv.pem ]; then
		mkdir -p /run/asgard
		KRB5CCNAME=FILE:/run/asgard/bifrost.ccache \
		    kinit -k "host/$(hostname)"
		KRB5CCNAME=FILE:/run/asgard/bifrost.ccache \
		    heimtools kx509 \
		    -o PEM-FILE:/var/heimdal/bifrost-priv.pem
		rm -f /run/asgard/bifrost.ccache
	fi
	rm -f /run/asgard/realms.changed /run/asgard/certificates.changed \
	    /run/asgard/inetd.changed
	if [ "$(hostname)" = "$(cat /var/heimdal/master)" ]; then
		rm -f "$ASGARD_IPROP_ACL"
	fi
	exec /usr/bin/tini -- /usr/bin/supervisord -c /etc/supervisord.conf
}

start_client() {

	[ $# -gt 0 ]	&& usage "start_client takes zero arguments"

	mkdir -p /run/bifrost /var/spool/tickets /var/spool/certs
	exec /usr/bin/tini -- /usr/bin/supervisord \
	    -c /etc/client-supervisord.conf
}

shell() {

	[ $# -gt 0 ]	&& usage "start_kdc takes zero arguments"

	prepare
	exec /bin/ksh -i
}

setup_master() {
	REALM="$1"

	[ $# -ne 1 ] && usage "setup-master needs exactly one REALM"

	echo Setting up KDC for REALM=$REALM

	# XXXrcd: this is a short term solution, eventually we will
	#         done something via bifrost only

	# XXXrcd: validate REALM

	cd /var/heimdal

	if [ -s /var/heimdal/realm ]; then
		[ "$REALM" = "$(cat /var/heimdal/realm)" ] ||
		    usage "KDC is already assigned to another realm"
		[ "$(hostname)" = "$(cat /var/heimdal/master)" ] ||
		    usage "KDC is configured as a slave"
	fi
	[ -f "$SETUP_FILE" ] && return

	echo "$REALM"	> /var/heimdal/realm
	hostname	> /var/heimdal/master

	write_krb5_conf master

	if [ "$(sqlite3 /var/heimdal/krb5_admin.db \
	    "SELECT count(*) FROM sqlite_schema WHERE name = 'db_version'")" = 0 ]; then
		krb5_admin -l init_db
	fi
	create_bifrost_admins
	if ! bifrost -l search_realm kind=local | grep -Fx "$REALM" >/dev/null; then
		bifrost -l create_realm "$REALM"
	fi
	if [ -z "$(bifrost -l query_host "$(hostname)")" ]; then
		bifrost -l create_host "$(hostname)" realm="$REALM"
	fi
	bifrost -l modify_realm "$REALM" \
	    "kdc+=$(hostname)" "master=$(hostname)"

	REALM_DN="$(realm_dn "$REALM")"
	if [ ! -s ca-priv.pem ]; then
		hxtool issue-certificate \
		    --self-signed --issue-ca --generate-key=rsa \
		    --subject="CN=CA,$REALM_DN" --lifetime=20years \
		    --certificate=FILE:ca-priv.pem.new
		mv ca-priv.pem.new ca-priv.pem
	fi

	hxtool cc --no-private-keys ca-priv.pem ca-pub.pem
	/scripts/asgard-install-certificates \
	    "$(/scripts/asgard-certificates "$(hostname)")"

	hxtool issue-certificate					\
			--ca-certificate=FILE:ca-priv.pem		\
			--generate-key=rsa				\
			--type=https-server				\
			--hostname="$(hostname)"			\
			--subject="CN=$(hostname)"			\
			--certificate=PEM-FILE:bifrost-priv.pem

	touch "$SETUP_FILE"
}

approve_slave() {
	[ $# -eq 3 ] || usage "approve-slave needs REALM HOST BINDING"
	REALM="$1"
	HOST="$2"
	BINDING="$3"
	[ -f "$SETUP_FILE" ] || usage "KDC is not setup yet"
	[ "$(hostname)" = "$(cat /var/heimdal/master)" ] ||
	    usage "slave approval must run on the master"
	bifrost -J -l query_realm "$REALM" |
	    jq -e --arg master "$(hostname)" \
	    '.kind == "local" and .master == $master' >/dev/null
	if [ -z "$(krb5_admin -l query_host "$HOST")" ]; then
		krb5_admin -l create_host "$HOST" realm="$REALM"
	fi
	[ "$(krb5_admin -J -l query_host "$HOST" | jq -r .realm)" = "$REALM" ] ||
	    usage "$HOST belongs to another realm"
	krb5_admin -l bind_host "$HOST" "$BINDING"
	bifrost -l modify_realm "$REALM" "kdc+=$HOST"
	/scripts/asgard-certificates "$HOST" >/dev/null
}

setup_slave() {
	REALM="$1"
	MASTER="$2"

	[ $# -ne 2 ] && usage "setup-slave needs two args, REALM and MASTER"
	if [ -f "$SETUP_FILE" ]; then
		[ "$REALM" = "$(cat /var/heimdal/realm)" ] &&
		    [ "$MASTER" = "$(cat /var/heimdal/master)" ] ||
		    usage "KDC is already assigned to another realm or master"
		return
	fi

	echo Setting up subservient KDC for REALM=$REALM >&2

	umask 077
	hxtool cc --no-private-keys FILE:/dev/stdin \
	    FILE:/var/heimdal/ca-pub.pem.new
	hxtool validate FILE:/var/heimdal/ca-pub.pem.new >&2
	mv /var/heimdal/ca-pub.pem.new /var/heimdal/ca-pub.pem

	echo "$REALM"	> /var/heimdal/realm
	echo "$MASTER"	> /var/heimdal/master

	write_krb5_conf slave
	krb5_keytab bootstrap/RANDOM
}

activate_slave() {
	[ $# -ne 0 ] && usage "activate-slave takes zero arguments"
	[ -s /var/heimdal/realm ] || usage "slave has no realm"
	[ -s /var/heimdal/master ] || usage "slave has no master"
	CONF="$(realm_conf_name "$(cat /var/heimdal/realm)")"
	[ -s "/var/heimdal/krb5.conf.d/$CONF.conf" ] ||
	    usage "slave has no realm configuration"
	[ -s /var/heimdal/ca-pub.pem ] || usage "slave has no CA certificate"
	[ -f "$SETUP_FILE" ] && return
	mkdir -p /run/asgard
	exec 9>/run/asgard/activate.lock
	flock -n 9 || usage "slave activation is already running"

	MASTER="$(cat /var/heimdal/master)"
	echo 'acquiring KDC keys' > /run/asgard/setup.status
	krb5_keytab
	krb5_keytab krb5_admin
	krb5_keytab HTTP
	krb5_keytab iprop
	echo 'receiving full HDB propagation' > /run/asgard/setup.status
	ipropd-slave -1 -k FILE:/etc/krb5.keytab "$MASTER"
	echo 'receiving administrative policy and certificates' > /run/asgard/setup.status
	timeout -k 5 180 knc -lf krb5_admin_sync /scripts/asgard-rsync &
	RECEIVER=$!
	trap 'kill "$RECEIVER" 2>/dev/null || :; wait "$RECEIVER" 2>/dev/null || :' EXIT
	trap 'exit 1' HUP INT TERM
	while [ ! -s /var/heimdal/admin-sync.time ]; do
		kill -0 "$RECEIVER" 2>/dev/null ||
		    usage "initial administrative replication did not complete; retry activation"
		sleep 1
	done
	kill "$RECEIVER" 2>/dev/null || :
	wait "$RECEIVER" 2>/dev/null || :
	trap - EXIT HUP INT TERM
	reconcile_realms
	touch "$SETUP_FILE"
	rm -f /run/asgard/setup.status
}


debug=0
while getopts d OPT; do
	case "$OPT" in
	d)	debug=$((debug + 1)) ;;
	*)	usage ;;
	esac
done
shift $((OPTIND - 1))

if [ $debug -gt 0 ]; then
	export KRB5_TRACE=0-$(expr $debug + 3)/SYSLOG
fi

if [ $# -eq 0 ]; then
	usage "We require at least one argument"
fi

CMD="$1"
shift

CMD=$(echo "$CMD" | sed s/_/-/g)

case "$CMD" in
	bifrost)		exec bifrost -l "$@"		;;
	status)			exec /scripts/asgard-status "$@"	;;
	reconcile)		reconcile "$@"			;;
	approve-slave)		approve_slave "$@"		;;
	activate-slave)		activate_slave "$@"		;;
	create-admin)		create_admin "$@"		;;
	print-ca)		print_ca "$@"			;;
	setup-master)		setup_master "$@"		;;
	setup-slave)		setup_slave "$@"		;;
	shell)			shell "$@"			;;
	start-kdc)		start_kdc "$@"			;;
	start-client)		start_client "$@"			;;
	*)			usage "unrecognised: $CMD"	;;
esac
