#!/bin/sh -e

if [ ! -f /var/heimdal/setup.done ]; then
	if [ -s /run/asgard/setup.status ]; then
		cat /run/asgard/setup.status
	elif [ -s /var/heimdal/realm ]; then
		echo 'awaiting setup completion'
	else
		echo unconfigured
	fi
	exit 1
fi

HOST=$(hostname)
MASTER=$(cat /var/heimdal/master)
set -- kdc kpasswdd ipropd inetd asgard-admin-sync
if [ "$HOST" = "$MASTER" ]; then
	set -- "$@" asgard-actiond
	[ -f /run/asgard/iprop-acl ] ||
	    { echo 'replication ACL is not ready'; exit 1; }
fi
supervisorctl -c /etc/supervisord.conf status "$@" \
    >/dev/null || { echo 'services are not running'; exit 1; }

TMP=$(mktemp -d /run/asgard/status.XXXXXX)
trap 'rm -rf "$TMP"' EXIT HUP INT TERM
REALM=$(cat /var/heimdal/realm)
cat > "$TMP/krb5.conf" <<EOM
[libdefaults]
	default_realm = $REALM
[realms]
	$REALM = {
		kdc = tcp/127.0.0.1
	}
EOM

KRB5_CONFIG="$TMP/krb5.conf" KRB5CCNAME="FILE:$TMP/ccache" \
    timeout 10 kinit -k "host/$HOST@$REALM"

for CERT in kdc kx509; do
	hxtool verify --missing-revoke \
	    "cert:FILE:/var/heimdal/$CERT-priv.pem" \
	    "chain:FILE:/var/heimdal/$CERT-priv.pem" \
	    anchor:FILE:/var/heimdal/ca-pub.pem >/dev/null
done

FAILED=0
STATUS=/var/heimdal/admin-sync/push.status
if [ "$HOST" != "$MASTER" ]; then
	STATUS=/var/heimdal/admin-sync/receive.status
	LAST=$(cat /var/heimdal/admin-sync.time)
	if [ $(( $(date +%s) - LAST )) -gt 180 ]; then
		echo 'administrative replication is more than three minutes behind'
		FAILED=1
	fi
fi
if [ -f "$STATUS" ] && grep -q ' failed' "$STATUS" &&
    ! grep -q ' failed authorize ' "$STATUS"; then
	cat "$STATUS"
	FAILED=1
fi
[ "$FAILED" = 0 ] || exit 1
echo ready
